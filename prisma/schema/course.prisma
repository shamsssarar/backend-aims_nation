// --- COURSE MODELS ---

model Course {
  id          String    @id @default(uuid())
  title       String
  description String?
  courseFee Int
  enrollments Enrollment[]
  invoices Invoice[]
  weeklyReport WeeklyReport[]
  studyMaterials StudyMaterial[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}
