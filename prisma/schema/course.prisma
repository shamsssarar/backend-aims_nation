// --- COURSE MODELS ---

model Course {
  id          String    @id @default(uuid())
  title       String
  description String?
  courseFee Int

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  teacherApplicantId String? 
  teacherApplicant TeacherApplication? @relation(fields: [teacherApplicantId], references: [id])

  schedule      String?         // e.g., "Sat/Sun 3:00 PM - 5:00 PM"
  roomNumber    String?         // e.g., "Room 1", "Room 2"
  maxCapacity   Int             @default(20) // Physical room limit

  enrollments Enrollment[]
  invoices Invoice[]
  weeklyReport WeeklyReport[]
  studyMaterials StudyMaterial[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}
