// --- ENUMS ---


// --- CORE AUTH MODELS (better-auth + AiMS Nation) ---

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(STUDENT) // AiMS Nation custom role

  // better-auth Core Relations
  sessions      Session[]
  accounts      Account[]
  invoices Invoice[]
enrollments   Enrollment[] @relation("StudentEnrollments")
  // AiMS Nation Custom Relations
  // students      Student[] @relation("ParentStudents") // If PARENT
//   batches       Batch[]   @relation("TeacherBatches") // If TEACHER

  // Audit Trails
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? 
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // better-auth email/password plugin stores the hashed password here
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}